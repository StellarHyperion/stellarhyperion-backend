{
  "name": "@hyperion/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Hyperion's off-chain half: the chain watchers that answer where a transfer is, and the keeper that moves it along",
  "license": "MIT",
  "author": "dotmantissa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StellarHyperion/stellarhyperion-backend.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "diagnostics": "node dist/cli/diagnostics.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "rails:backlog": "node --env-file-if-exists=.env --experimental-strip-types src/rails/inspect.ts",
    "migrate": "node-pg-migrate --envPath .env --migrations-dir migrations --migrations-table pgmigrations --advisory-lock-mode wait",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "rail:requeue": "node --env-file-if-exists=.env dist/rails/requeue-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fmt": "prettier --write \"**/*.{ts,mts,mjs,cjs,json,md,yml,yaml}\"",
    "fmt:check": "prettier --check \"**/*.{ts,mts,mjs,cjs,json,md,yml,yaml}\"",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm run test",
    "evm:backfill": "node --env-file-if-exists=.env dist/chains/evm/backfill-cli.js",
    "evm:quarantine": "node --env-file-if-exists=.env dist/chains/evm/quarantine-cli.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@hyperion/protocol": "file:hyperion-protocol-0.1.0.tgz",
    "@stellar/stellar-sdk": "^17.4.0",
    "bullmq": "^6.7.6",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "node-pg-migrate": {
      "glob": "14.0.6"
    },
    "eslint": {
      "minimatch": "11.0.9"
    }
  }
}
