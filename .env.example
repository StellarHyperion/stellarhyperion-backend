# Copy to .env and fill in. Nothing in this file is a real credential, and .env is gitignored.
#
# Every variable below is read through src/config/env.ts, which fails at startup and names every
# variable it could not satisfy rather than the first one. A process that boots with half a
# configuration and discovers the rest on the first inbound transfer is a process that discovers
# it at the worst possible moment.

# ---------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------

# Postgres. docker compose up publishes on 5433 so it does not fight whatever else you already
# have on 5432.
DATABASE_URL=postgres://hyperion:replace-me@127.0.0.1:5433/hyperion

# Redis. Nothing connects to it yet. It is required here because the keeper in B6 is the next
# thing to land and an operator who deploys without it would find out from a queue that silently
# does nothing.
REDIS_URL=redis://127.0.0.1:6380

# mainnet or testnet. Picks which half of the chain registry in @hyperion/protocol is in play,
# and a deployment record for the wrong half is refused rather than quietly watched.
HYPERION_NETWORK=testnet

# The deployment record the contracts repo writes, parsed with parseDeploymentSet from
# @hyperion/protocol. Router addresses, token decimals, flow ceilings and the ledger or block
# each router was deployed in all come from here, so the watchers never guess a start height.
HYPERION_DEPLOYMENTS_FILE=./deployments/testnet.json

# ---------------------------------------------------------------------------------------------
# Optional, with the defaults shown
# ---------------------------------------------------------------------------------------------

# development, test or production. Only changes log formatting and how loudly config errors print.
NODE_ENV=development

# trace, debug, info, warn, error or fatal.
LOG_LEVEL=info

HTTP_HOST=127.0.0.1
HTTP_PORT=8080

# Set to false to run the API without the watchers, which is what a second replica wants.
INDEXER_ENABLED=true

# How long shutdown waits for in-flight work before it stops waiting.
SHUTDOWN_TIMEOUT_MS=10000

# Soroban RPC. Defaults to the endpoint in the chain registry for the configured network.
# A public endpoint is fine for a demo and will rate limit you under real load.
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Events per getEvents page. The RPC caps this at 10000 server side; 200 is a page that fits in
# one database transaction without holding a connection for long. Raise it only if a single
# ledger ever holds more router events than this, which the watcher says loudly if it happens.
STELLAR_EVENT_PAGE_SIZE=200

# Overrides where a fresh Stellar cursor starts. Normally left unset: the start ledger comes from
# the deployment record. Set it when that record is wrong about the router's first ledger, which
# the phase 1 testnet record is: deployedAt.ledger is written when the deploy script finishes, and
# the router had already emitted its initialisation and seven queued actions by then. Ignored once
# a cursor exists, so it cannot be used to rewind a running indexer.
# STELLAR_START_LEDGER=4965900

# Ledgers close in about five seconds, so polling faster than that mostly asks for nothing.
STELLAR_POLL_INTERVAL_MS=5000

EVM_POLL_INTERVAL_MS=4000

# Blocks per getLogs call. Public endpoints reject wide ranges; 2000 is under every limit we
# have met. It is an endpoint's limit rather than a property of the data, and the indexed rows do
# not depend on it: there is a test that reads the same history at 2000 and at 2 and compares.
EVM_LOG_RANGE=2000

# Per chain RPC overrides. Default is the endpoint in the chain registry. Name the chain in
# upper case with dashes as underscores: EVM_RPC_URL_BASE_SEPOLIA, EVM_RPC_URL_ARC_TESTNET.
# EVM_RPC_URL_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
# EVM_RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
# EVM_RPC_URL_ARC_TESTNET=https://rpc.testnet.arc.io

# How far back the cursor winds when a reorg is found below the confirmation depth. This is not
# a re-read on every pass: the watcher only indexes up to the head minus that chain's own
# confirmations, so an ordinary pass trusts its cursor. What it does do on every pass is re-read
# the hash of the block the cursor sits on, and a hash that no longer matches is a reorg that
# reached past the depth the registry claims is enough. That is reported at error level and the
# cursor winds back by this many blocks so the corrected blocks are read again.
#
# Defaults to the chain's own confirmations from the registry, which is the right number per chain
# and the reason this is usually left alone.
# EVM_REORG_DEPTH_BLOCKS=12

# Only for the integration tests. They skip themselves when this is unset, so a contributor
# without docker still gets a green unit suite.
# TEST_DATABASE_URL=postgres://hyperion:replace-me@127.0.0.1:5433/hyperion_test
